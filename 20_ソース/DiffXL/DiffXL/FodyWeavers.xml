<?xml version="1.0" encoding="utf-8"?>
<Weavers xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="FodyWeavers.xsd">
  <Costura>
    <!--
      マネージ依存（YamlDotNet / OpenCvSharp 等）は Costura で exe に埋め込む。
      OpenCV ネイティブ（OpenCvSharpExtern / ffmpeg）は csproj の EmbeddedResource で exe に含め、
      実行時 NativeBootstrap が %AppData%\Roaming\DiffXL\native へ展開する。
      Costura の Unmanaged* は使わない（二重埋め込みと temp 展開の衝突を避ける）。
    -->
  </Costura>
</Weavers>
