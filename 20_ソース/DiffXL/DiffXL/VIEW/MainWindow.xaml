<Window
    x:Class="DiffXL.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:DiffXL.VIEW.Controls"
    xmlns:view="clr-namespace:DiffXL.VIEW"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="DiffXL"
    Width="1360"
    Height="840"
    MinWidth="960"
    MinHeight="560"
    WindowStartupLocation="CenterScreen"
    Closing="Window_Closing"
    PreviewKeyDown="Window_PreviewKeyDown"
    SizeChanged="Window_SizeChanged"
    StateChanged="Window_StateChanged"
    mc:Ignorable="d">
    <Grid>
        <!-- メイン比較画面 -->
        <DockPanel x:Name="MainCompareRoot" Visibility="Collapsed">
            <Border
                DockPanel.Dock="Top"
                Style="{StaticResource AppToolbarBorderStyle}">
                <DockPanel>
                    <StackPanel
                        DockPanel.Dock="Left"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                        <iconPacks:PackIconPhosphorIcons
                            Kind="MicrosoftExcelLogo"
                            Width="18"
                            Height="18"
                            VerticalAlignment="Center"
                            Margin="0,0,8,0"
                            Foreground="{StaticResource Brush.Accent}" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="16"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource Brush.Text}"
                            Text="DiffXL" />
                    </StackPanel>
                    <StackPanel
                        DockPanel.Dock="Right"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                        <iconPacks:PackIconPhosphorIcons
                            Kind="Rows"
                            Width="14"
                            Height="14"
                            Margin="0,0,4,0"
                            VerticalAlignment="Center"
                            Foreground="{StaticResource Brush.TextMuted}" />
                        <TextBlock
                            Margin="0,0,6,0"
                            VerticalAlignment="Center"
                            Foreground="{StaticResource Brush.TextMuted}"
                            Text="シート" />
                        <ComboBox
                            x:Name="PairSheetCombo"
                            Style="{StaticResource ToolBarComboBoxStyle}"
                            Width="200"
                            MinWidth="160"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            ToolTip="既知のシート対応をまとめて切り替えます（MiniMap も現在シートのみ再構築）"
                            SelectionChanged="PairSheetCombo_SelectionChanged" />
                        <Button
                            x:Name="BtnCompareCurrentPair"
                            Style="{StaticResource ToolBarButtonStyle}"
                            MinWidth="128"
                            Margin="0,0,6,0"
                            Click="BtnCompareCurrentPair_Click"
                            ToolTip="左右ペインで選んだシートを手動ペアとして再比較します（異名・片側可）">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconPhosphorIcons Kind="GitMerge" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="この組み合わせで比較" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnRecompare" Style="{StaticResource ToolBarButtonStyle}" MinWidth="72" Margin="0,0,6,0" Click="BtnRecompare_Click">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconPhosphorIcons Kind="ArrowsClockwise" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="再比較" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnSheetMap" Style="{StaticResource ToolBarButtonStyle}" MinWidth="88" Margin="0,0,6,0" Click="BtnSheetMap_Click">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconPhosphorIcons Kind="Link" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="シート対応" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnReplaceLeft" Style="{StaticResource ToolBarButtonStyle}" MinWidth="80" Margin="0,0,6,0" Click="BtnReplaceLeft_Click">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconPhosphorIcons Kind="ArrowFatLeft" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="左差し替え" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnReplaceRight" Style="{StaticResource ToolBarButtonStyle}" MinWidth="80" Margin="0,0,6,0" Click="BtnReplaceRight_Click">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconPhosphorIcons Kind="ArrowFatRight" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="右差し替え" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <ToggleButton
                            x:Name="BtnHighlightToggle"
                            Style="{StaticResource ToolBarToggleButtonStyle}"
                            MinWidth="100"
                            Margin="0,0,6,0"
                            ToolTip="差分オーバーレイ表示／非表示 (Ctrl+H)"
                            IsChecked="True"
                            Checked="BtnHighlightToggle_CheckedChanged"
                            Unchecked="BtnHighlightToggle_CheckedChanged">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconPhosphorIcons
                                    x:Name="BtnHighlightToggleIcon"
                                    Kind="HighlighterCircle"
                                    Width="14"
                                    Height="14"
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center"
                                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                                <TextBlock
                                    x:Name="BtnHighlightToggleLabel"
                                    VerticalAlignment="Center"
                                    Text="差分強調 ON" />
                            </StackPanel>
                        </ToggleButton>
                        <Button x:Name="BtnSettings" Style="{StaticResource ToolBarButtonStyle}" MinWidth="64" Margin="0,0,6,0" Click="BtnSettings_Click">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconPhosphorIcons Kind="GearSix" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="設定" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnBackToStart" Style="{StaticResource ToolBarButtonStyle}" MinWidth="100" Click="BtnBackToStart_Click">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconPhosphorIcons Kind="House" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="最初から" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <TextBlock
                        x:Name="StatusText"
                        Margin="12,0"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource Brush.TextMuted}"
                        Text=""
                        TextTrimming="CharacterEllipsis" />
                </DockPanel>
            </Border>

            <StatusBar DockPanel.Dock="Bottom" Background="#F9FAFB">
                <StatusBarItem>
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconPhosphorIcons Kind="Info" Width="12" Height="12" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="#6B7280" />
                        <TextBlock x:Name="FooterText" Text="準備完了" VerticalAlignment="Center" />
                    </StackPanel>
                </StatusBarItem>
                <Separator />
                <StatusBarItem>
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconPhosphorIcons Kind="GitDiff" Width="12" Height="12" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="#6B7280" />
                        <TextBlock x:Name="StatusDiffText" Text="差分 —" VerticalAlignment="Center" />
                    </StackPanel>
                </StatusBarItem>
                <Separator />
                <StatusBarItem HorizontalAlignment="Right">
                    <StackPanel
                        x:Name="SyncStatusPanel"
                        Orientation="Horizontal"
                        ToolTip="同期状態">
                        <iconPacks:PackIconPhosphorIcons Kind="ArrowsDownUp" Width="12" Height="12" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="#6B7280" />
                        <TextBlock x:Name="SyncStatusText" Text="同期 —" VerticalAlignment="Center" />
                    </StackPanel>
                </StatusBarItem>
            </StatusBar>

            <!-- 再同期ジャンプ通知（ギャップ→Equal・|Δ|≥3）。1800ms 表示 -->
            <Border
                x:Name="SyncToast"
                DockPanel.Dock="Bottom"
                Margin="16,0,16,8"
                Padding="14,8"
                HorizontalAlignment="Center"
                Background="#EE1D4ED8"
                CornerRadius="8"
                Visibility="Collapsed"
                IsHitTestVisible="False">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconPhosphorIcons
                        Kind="ArrowsClockwise"
                        Width="14"
                        Height="14"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        Foreground="White" />
                    <TextBlock
                        x:Name="SyncToastText"
                        VerticalAlignment="Center"
                        Foreground="White"
                        FontSize="12"
                        Text="" />
                </StackPanel>
            </Border>

            <Grid Margin="4" MinHeight="200">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="180" />
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="*" MinWidth="180" />
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="80" MinWidth="72" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <controls:WorkbookPane x:Name="LeftPane" Grid.Column="0" PaneTitle="左" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#D1D5DB" ResizeBehavior="PreviousAndNext" />
                <controls:WorkbookPane x:Name="RightPane" Grid.Column="2" PaneTitle="右" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                <GridSplitter Grid.Column="3" Width="4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#D1D5DB" ResizeBehavior="PreviousAndNext" />
                <controls:MiniMapControl
                    x:Name="MiniMap"
                    Grid.Column="4"
                    Panel.ZIndex="10"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch" />
            </Grid>
        </DockPanel>

        <!-- 起動／ファイル選択 -->
        <view:StartupPanel x:Name="Startup" />

        <!-- 比較中マスク -->
        <Border
            x:Name="LoadingMask"
            Background="#88000000"
            Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <iconPacks:PackIconPhosphorIcons
                    Kind="Hourglass"
                    Width="36"
                    Height="36"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,12"
                    Foreground="White" />
                <TextBlock
                    FontSize="18"
                    FontWeight="SemiBold"
                    Foreground="White"
                    HorizontalAlignment="Center"
                    Text="比較中..." />
                <TextBlock
                    x:Name="LoadingDetail"
                    Margin="0,8,0,0"
                    Foreground="#E5E7EB"
                    HorizontalAlignment="Center"
                    Text="" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
