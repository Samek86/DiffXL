<UserControl
    x:Class="DiffXL.VIEW.StartupPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    Background="{StaticResource Brush.BgApp}">
    <Grid>
        <Border
            Width="560"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Style="{StaticResource CardBorderStyle}">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <iconPacks:PackIconPhosphorIcons
                        Kind="MicrosoftExcelLogo"
                        Width="28"
                        Height="28"
                        Margin="0,0,10,0"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource Brush.Accent}" />
                    <TextBlock
                        FontSize="22"
                        FontWeight="SemiBold"
                        VerticalAlignment="Center"
                        Text="DiffXL" />
                </StackPanel>
                <TextBlock
                    Margin="0,0,0,20"
                    Foreground="{StaticResource Brush.TextMuted}"
                    TextWrapping="Wrap"
                    Text="比較する 2 つの Excel ファイル（.xlsx）を選択してください。" />

                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <iconPacks:PackIconPhosphorIcons Kind="FileXls" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="{StaticResource Brush.Text}" />
                    <TextBlock FontWeight="SemiBold" Text="左ファイル" VerticalAlignment="Center" />
                </StackPanel>
                <DockPanel Margin="0,0,0,12">
                    <Button
                        DockPanel.Dock="Right"
                        MinWidth="88"
                        Margin="8,0,0,0"
                        Click="BtnPickLeft_Click">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconPhosphorIcons Kind="FolderOpen" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="参照..." VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Border
                        Padding="8,6"
                        Background="{StaticResource Brush.BgMuted}"
                        BorderBrush="{StaticResource Brush.Border}"
                        BorderThickness="1"
                        CornerRadius="6">
                        <TextBlock
                            x:Name="LeftPathText"
                            Text="（未選択）"
                            TextTrimming="CharacterEllipsis"
                            Foreground="{StaticResource Brush.TextMuted}" />
                    </Border>
                </DockPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <iconPacks:PackIconPhosphorIcons Kind="FileXls" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="{StaticResource Brush.Text}" />
                    <TextBlock FontWeight="SemiBold" Text="右ファイル" VerticalAlignment="Center" />
                </StackPanel>
                <DockPanel Margin="0,0,0,20">
                    <Button
                        DockPanel.Dock="Right"
                        MinWidth="88"
                        Margin="8,0,0,0"
                        Click="BtnPickRight_Click">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconPhosphorIcons Kind="FolderOpen" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="参照..." VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Border
                        Padding="8,6"
                        Background="{StaticResource Brush.BgMuted}"
                        BorderBrush="{StaticResource Brush.Border}"
                        BorderThickness="1"
                        CornerRadius="6">
                        <TextBlock
                            x:Name="RightPathText"
                            Text="（未選択）"
                            TextTrimming="CharacterEllipsis"
                            Foreground="{StaticResource Brush.TextMuted}" />
                    </Border>
                </DockPanel>

                <Button
                    x:Name="BtnStartCompare"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Height="40"
                    HorizontalAlignment="Stretch"
                    IsEnabled="False"
                    Click="BtnStartCompare_Click">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <iconPacks:PackIconPhosphorIcons
                            Kind="GitDiff"
                            Width="18"
                            Height="18"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Foreground="White" />
                        <TextBlock Text="比較開始" VerticalAlignment="Center" Foreground="White" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
