<UserControl
    x:Class="DiffXL.VIEW.Controls.TableDiffGrid"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    mc:Ignorable="d"
    d:DesignHeight="200"
    d:DesignWidth="480">
    <Border
        Margin="0,0,0,12"
        Padding="8"
        Background="#FFFFFFFF"
        BorderBrush="#FFD1D5DB"
        BorderThickness="1"
        CornerRadius="6">
        <StackPanel>
            <TextBlock
                x:Name="TitleText"
                Margin="0,0,0,8"
                Foreground="#FF111827"
                FontSize="12"
                FontWeight="SemiBold"
                TextWrapping="Wrap"
                Text="テーブル" />
            <TextBlock
                x:Name="SubtitleText"
                Margin="0,0,0,8"
                Foreground="#FF6B7280"
                FontSize="11"
                TextWrapping="Wrap"
                Text="" />
            <ItemsControl x:Name="RowsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Margin="0,0,0,3"
                            Padding="4,3"
                            Background="{Binding RowBackground}"
                            BorderBrush="{Binding RowBorder}"
                            BorderThickness="1"
                            CornerRadius="3">
                            <DockPanel>
                                <TextBlock
                                    DockPanel.Dock="Left"
                                    MinWidth="56"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold"
                                    FontSize="11"
                                    Foreground="{Binding MarkerForeground}"
                                    Text="{Binding Marker}"
                                    ToolTip="{Binding Tooltip}" />
                                <ItemsControl ItemsSource="{Binding Cells}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border
                                                MinWidth="48"
                                                Margin="0,0,3,0"
                                                Padding="6,3"
                                                Background="{Binding CellBackground}"
                                                BorderBrush="#FFE5E7EB"
                                                BorderThickness="1"
                                                CornerRadius="2">
                                                <TextBlock
                                                    FontFamily="Consolas, Yu Gothic UI, sans-serif"
                                                    FontSize="12"
                                                    Foreground="{Binding TextForeground}"
                                                    Text="{Binding Text}"
                                                    TextWrapping="Wrap" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock
                x:Name="EmptyHint"
                Visibility="Collapsed"
                Margin="0,4,0,0"
                Foreground="#FF6B7280"
                FontSize="12"
                Text="（行なし）" />
        </StackPanel>
    </Border>
</UserControl>
