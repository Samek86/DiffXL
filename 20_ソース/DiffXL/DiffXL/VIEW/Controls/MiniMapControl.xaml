<UserControl
    x:Class="DiffXL.VIEW.Controls.MiniMapControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    MinWidth="88"
    Background="#FFFFFFFF"
    Focusable="True"
    ToolTip="スクロールバーのようにクリック／ドラッグで内容をスクロール。黄=差分位置、青帯=表示位置">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="4,6,4,2">
            <iconPacks:PackIconPhosphorIcons
                Kind="MapTrifold"
                Width="16"
                Height="16"
                HorizontalAlignment="Center"
                Margin="0,0,0,4"
                Foreground="#FFD97706" />
            <TextBlock
                HorizontalAlignment="Center"
                FontSize="11"
                FontWeight="SemiBold"
                Foreground="#FF111827"
                Text="MiniMap" />
        </StackPanel>
        <Border
            x:Name="MapBorder"
            Grid.Row="1"
            Margin="6,0,6,4"
            Background="#FFF3F4F6"
            BorderBrush="#FFD97706"
            BorderThickness="2"
            CornerRadius="3"
            Cursor="Hand"
            ClipToBounds="True"
            PreviewMouseLeftButtonDown="MapBorder_PreviewMouseLeftButtonDown"
            PreviewMouseMove="MapBorder_PreviewMouseMove"
            PreviewMouseLeftButtonUp="MapBorder_PreviewMouseLeftButtonUp"
            SizeChanged="MapBorder_SizeChanged">
            <Canvas
                x:Name="MapCanvas"
                Background="Transparent"
                IsHitTestVisible="True" />
        </Border>
        <StackPanel Grid.Row="2" Margin="4,0,4,6" HorizontalAlignment="Center">
            <iconPacks:PackIconPhosphorIcons
                Kind="CursorClick"
                Width="12"
                Height="12"
                HorizontalAlignment="Center"
                Margin="0,0,0,2"
                Foreground="#FF6B7280" />
            <TextBlock
                x:Name="HintText"
                HorizontalAlignment="Center"
                FontSize="11"
                Foreground="#FF374151"
                Text="ドラッグでスクロール"
                TextAlignment="Center"
                TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</UserControl>
