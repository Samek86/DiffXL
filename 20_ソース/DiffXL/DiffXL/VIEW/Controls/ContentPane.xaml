<UserControl
    x:Class="DiffXL.VIEW.Controls.ContentPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    mc:Ignorable="d"
    d:DesignHeight="400"
    d:DesignWidth="480">
    <Grid Background="#FF0B1220">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Padding="8,6"
            Background="#FF111827"
            BorderBrush="#FF374151"
            BorderThickness="0,0,0,1">
            <TextBlock
                x:Name="HeaderText"
                Foreground="#FFE5E7EB"
                FontSize="12"
                TextWrapping="Wrap"
                Text="内容未読込" />
        </Border>

        <TabControl
            x:Name="ContentTabs"
            Grid.Row="1"
            Background="Transparent"
            BorderThickness="0"
            Padding="0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Padding" Value="12,6" />
                    <Setter Property="Foreground" Value="#FFE5E7EB" />
                    <Setter Property="Background" Value="#FF1F2937" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border
                                    x:Name="TabBd"
                                    Padding="{TemplateBinding Padding}"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="#FF374151"
                                    BorderThickness="1,1,1,0"
                                    Margin="0,0,2,0"
                                    CornerRadius="4,4,0,0">
                                    <ContentPresenter
                                        ContentSource="Header"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="TabBd" Property="Background" Value="#FF2563EB" />
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="TabBd" Property="Background" Value="#FF374151" />
                                    </Trigger>
                                    <MultiTrigger>
                                        <MultiTrigger.Conditions>
                                            <Condition Property="IsSelected" Value="True" />
                                            <Condition Property="IsMouseOver" Value="True" />
                                        </MultiTrigger.Conditions>
                                        <Setter TargetName="TabBd" Property="Background" Value="#FF1D4ED8" />
                                    </MultiTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <TabItem Header="セル">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="8">
                    <StackPanel>
                        <TextBlock
                            x:Name="CellsSummary"
                            Foreground="#FF9CA3AF"
                            Margin="0,0,0,8"
                            TextWrapping="Wrap"
                            Text="セル（テーブル外）" />
                        <ItemsControl x:Name="CellsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Margin="0,0,0,4"
                                        Padding="8,6"
                                        Background="#FF1F2937"
                                        BorderBrush="#FF374151"
                                        BorderThickness="1"
                                        CornerRadius="4">
                                        <TextBlock
                                            Text="{Binding}"
                                            Foreground="#FFF9FAFB"
                                            TextWrapping="Wrap"
                                            FontFamily="Consolas, Yu Gothic UI, sans-serif"
                                            FontSize="12" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="テーブル">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="8">
                    <StackPanel>
                        <TextBlock
                            x:Name="TablesSummary"
                            Foreground="#FF9CA3AF"
                            Margin="0,0,0,8"
                            TextWrapping="Wrap"
                            Text="テーブル" />
                        <ItemsControl x:Name="TablesList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Margin="0,0,0,4"
                                        Padding="8,6"
                                        Background="#FF1F2937"
                                        BorderBrush="#FF374151"
                                        BorderThickness="1"
                                        CornerRadius="4">
                                        <TextBlock
                                            Text="{Binding}"
                                            Foreground="#FFF9FAFB"
                                            TextWrapping="Wrap"
                                            FontSize="12" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="画像">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="8">
                    <StackPanel>
                        <TextBlock
                            x:Name="ImagesSummary"
                            Foreground="#FF9CA3AF"
                            Margin="0,0,0,8"
                            TextWrapping="Wrap"
                            Text="画像" />
                        <ItemsControl x:Name="ImagesList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Margin="0,0,0,4"
                                        Padding="8,6"
                                        Background="#FF1F2937"
                                        BorderBrush="#FF374151"
                                        BorderThickness="1"
                                        CornerRadius="4">
                                        <TextBlock
                                            Text="{Binding}"
                                            Foreground="#FFF9FAFB"
                                            TextWrapping="Wrap"
                                            FontSize="12" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="図形">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="8">
                    <StackPanel>
                        <TextBlock
                            x:Name="ShapesSummary"
                            Foreground="#FF9CA3AF"
                            Margin="0,0,0,8"
                            TextWrapping="Wrap"
                            Text="図形" />
                        <ItemsControl x:Name="ShapesList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Margin="0,0,0,4"
                                        Padding="8,6"
                                        Background="#FF1F2937"
                                        BorderBrush="#FF374151"
                                        BorderThickness="1"
                                        CornerRadius="4">
                                        <TextBlock
                                            Text="{Binding}"
                                            Foreground="#FFF9FAFB"
                                            TextWrapping="Wrap"
                                            FontSize="12" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
