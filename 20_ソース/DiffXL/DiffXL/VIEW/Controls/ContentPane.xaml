<UserControl
    x:Class="DiffXL.VIEW.Controls.ContentPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    mc:Ignorable="d"
    d:DesignHeight="400"
    d:DesignWidth="480">
    <Grid Background="#FFF9FAFB">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Padding="8,6"
            Background="#FFFFFFFF"
            BorderBrush="#FFE5E7EB"
            BorderThickness="0,0,0,1">
            <TextBlock
                x:Name="HeaderText"
                Foreground="#FF111827"
                FontSize="12"
                TextWrapping="Wrap"
                Text="内容未読込" />
        </Border>

        <!-- 次の差分の対象だけを絞る（本文ストリームは隠さない） -->
        <StackPanel
            Grid.Row="1"
            Orientation="Horizontal"
            Margin="8,4,8,4">
            <ToggleButton
                x:Name="ChipAll"
                Style="{StaticResource ToolBarToggleButtonStyle}"
                Padding="8,2"
                MinHeight="22"
                FontSize="11"
                Margin="0,0,4,0"
                IsChecked="True"
                Click="KindFilterChip_Click"
                ToolTip="次の差分: すべて"
                Content="すべて" />
            <ToggleButton
                x:Name="ChipTable"
                Style="{StaticResource ToolBarToggleButtonStyle}"
                Padding="8,2"
                MinHeight="22"
                FontSize="11"
                Margin="0,0,4,0"
                Click="KindFilterChip_Click"
                ToolTip="次の差分: 表のみ"
                Content="表" />
            <ToggleButton
                x:Name="ChipImage"
                Style="{StaticResource ToolBarToggleButtonStyle}"
                Padding="8,2"
                MinHeight="22"
                FontSize="11"
                Margin="0,0,4,0"
                Click="KindFilterChip_Click"
                ToolTip="次の差分: 画像のみ"
                Content="画像" />
            <ToggleButton
                x:Name="ChipCell"
                Style="{StaticResource ToolBarToggleButtonStyle}"
                Padding="8,2"
                MinHeight="22"
                FontSize="11"
                Click="KindFilterChip_Click"
                ToolTip="次の差分: 表の外のセルのみ"
                Content="セル" />
        </StackPanel>

        <!-- 仮想化: Top/Bottom スペーサ + 可視範囲のみ ViewportHost に生成 -->
        <ScrollViewer
            x:Name="StreamScroll"
            Grid.Row="2"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Auto"
            Padding="8"
            Background="#FFF9FAFB"
            ScrollChanged="StreamScroll_ScrollChanged"
            SizeChanged="StreamScroll_SizeChanged">
            <StackPanel x:Name="StreamRoot">
                <FrameworkElement x:Name="TopSpacer" Height="0" Focusable="False" />
                <StackPanel x:Name="ViewportHost" />
                <FrameworkElement x:Name="BottomSpacer" Height="0" Focusable="False" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
