<UserControl
    x:Class="DiffXL.VIEW.Controls.ContentPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    mc:Ignorable="d"
    d:DesignHeight="400"
    d:DesignWidth="480">
    <Grid Background="#FFF9FAFB">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Padding="8,6"
            Background="#FFFFFFFF"
            BorderBrush="#FFE5E7EB"
            BorderThickness="0,0,0,1">
            <TextBlock
                x:Name="HeaderText"
                Foreground="#FF111827"
                FontSize="12"
                TextWrapping="Wrap"
                Text="内容未読込" />
        </Border>

        <!-- セル／表／画像／図形をドキュメント順に 1 本のストリームで表示 -->
        <ScrollViewer
            x:Name="StreamScroll"
            Grid.Row="1"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Auto"
            Padding="8"
            Background="#FFF9FAFB"
            ScrollChanged="StreamScroll_ScrollChanged">
            <StackPanel x:Name="StreamHost" />
        </ScrollViewer>
    </Grid>
</UserControl>
