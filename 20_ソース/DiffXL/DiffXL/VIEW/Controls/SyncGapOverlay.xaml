<UserControl
    x:Class="DiffXL.VIEW.Controls.SyncGapOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    IsHitTestVisible="False"
    Background="Transparent">
    <!--
      Excel は HwndHost のため同ツリー上の兄弟では描画されない（airspace）。
      別 HWND の Popup でホスト矩形上に載せ、WS_EX_TRANSPARENT でクリック透過する。
    -->
    <Popup
        x:Name="OverlayPopup"
        AllowsTransparency="True"
        Placement="Relative"
        PlacementTarget="{Binding RelativeSource={RelativeSource AncestorType=UserControl}}"
        StaysOpen="True"
        IsHitTestVisible="False"
        PopupAnimation="None">
        <Grid
            x:Name="OverlayRoot"
            IsHitTestVisible="False"
            Background="#99000000">
            <Border
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MaxWidth="280"
                Margin="16"
                Padding="16,14"
                Background="#EBFFFFFF"
                CornerRadius="8"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                IsHitTestVisible="False">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.18" Direction="270" Color="#000000" />
                </Border.Effect>
                <StackPanel IsHitTestVisible="False">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <iconPacks:PackIconPhosphorIcons
                            x:Name="Icon"
                            Kind="Pause"
                            Width="20"
                            Height="20"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Foreground="#374151" />
                        <TextBlock
                            x:Name="TitleText"
                            VerticalAlignment="Center"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="#111827"
                            TextWrapping="Wrap"
                            Text="こちらで待機中" />
                    </StackPanel>
                    <TextBlock
                        x:Name="CaptionText"
                        FontSize="12"
                        Foreground="#4B5563"
                        TextWrapping="Wrap"
                        Text="" />
                </StackPanel>
            </Border>
        </Grid>
    </Popup>
</UserControl>
