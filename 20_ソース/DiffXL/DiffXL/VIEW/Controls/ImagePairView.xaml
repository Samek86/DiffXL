<UserControl
    x:Class="DiffXL.VIEW.Controls.ImagePairView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    mc:Ignorable="d"
    d:DesignHeight="220"
    d:DesignWidth="360">
    <Border
        Margin="0,0,0,12"
        Padding="8"
        Background="#FF111827"
        BorderBrush="#FF374151"
        BorderThickness="1"
        CornerRadius="6">
        <StackPanel>
            <TextBlock
                x:Name="TitleText"
                Margin="0,0,0,4"
                Foreground="#FFE5E7EB"
                FontSize="12"
                FontWeight="SemiBold"
                TextWrapping="Wrap"
                Text="画像" />
            <TextBlock
                x:Name="SubtitleText"
                Margin="0,0,0,8"
                Foreground="#FF9CA3AF"
                FontSize="11"
                TextWrapping="Wrap"
                Text="" />
            <!-- ギャップ（相手側のみの行など） -->
            <Border
                x:Name="GapBox"
                MinHeight="72"
                Padding="12"
                Background="#FF0B1220"
                BorderBrush="#FF4B5563"
                BorderThickness="1"
                CornerRadius="4"
                Visibility="Collapsed">
                <TextBlock
                    x:Name="GapText"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="#FF9CA3AF"
                    FontSize="12"
                    Text="（この側に画像なし）" />
            </Border>
            <!-- 画像本体 + ハイライト Canvas -->
            <Border
                x:Name="ImageFrame"
                HorizontalAlignment="Left"
                Background="#FF0B1220"
                BorderBrush="#FF4B5563"
                BorderThickness="1"
                CornerRadius="4"
                ClipToBounds="True">
                <Grid x:Name="ImageGrid">
                    <Image
                        x:Name="MainImage"
                        Stretch="Fill"
                        SnapsToDevicePixels="True" />
                    <Canvas
                        x:Name="HighlightCanvas"
                        IsHitTestVisible="False" />
                </Grid>
            </Border>
            <TextBlock
                x:Name="EmptyHint"
                Visibility="Collapsed"
                Margin="0,4,0,0"
                Foreground="#FF6B7280"
                FontSize="12"
                Text="（画像を読み込めません）" />
        </StackPanel>
    </Border>
</UserControl>
