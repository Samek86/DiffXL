<Window
    x:Class="DiffXL.VIEW.Dialogs.SheetMapDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    Title="シート対応付け"
    Width="640"
    Height="520"
    WindowStartupLocation="CenterOwner"
    ResizeMode="CanResizeWithGrip">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
            <iconPacks:PackIconPhosphorIcons Kind="Link" Width="16" Height="16" Margin="0,2,8,0" VerticalAlignment="Top" Foreground="{StaticResource Brush.Accent}" />
            <TextBlock
                TextWrapping="Wrap"
                Text="左右シートの対応を指定します。異名ペア・片側のみ（「なし」）を追加できます。同名リセットで自動対応に戻します。" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button MinWidth="88" Margin="0,0,8,0" Padding="10,6" IsCancel="True" Click="BtnCancel_Click">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconPhosphorIcons Kind="X" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock Text="キャンセル" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button
                Style="{StaticResource PrimaryButtonStyle}"
                MinWidth="120"
                Padding="10,6"
                IsDefault="True"
                Click="BtnOk_Click">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconPhosphorIcons Kind="Check" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="White" />
                    <TextBlock Text="適用して再比較" VerticalAlignment="Center" Foreground="White" FontWeight="SemiBold" />
                </StackPanel>
            </Button>
        </StackPanel>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="120" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="1.1*" MinHeight="140" />
            </Grid.RowDefinitions>

            <!-- 候補リスト -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <DockPanel Grid.Column="0">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                        <iconPacks:PackIconPhosphorIcons Kind="ArrowFatLeft" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock FontWeight="SemiBold" Text="左シート" VerticalAlignment="Center" />
                    </StackPanel>
                    <ListBox x:Name="LeftList" Margin="0,6,0,0" />
                </DockPanel>
                <DockPanel Grid.Column="2">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                        <iconPacks:PackIconPhosphorIcons Kind="ArrowFatRight" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock FontWeight="SemiBold" Text="右シート" VerticalAlignment="Center" />
                    </StackPanel>
                    <ListBox x:Name="RightList" Margin="0,6,0,0" />
                </DockPanel>
            </Grid>

            <!-- 操作 -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,10">
                <Button MinWidth="100" Margin="0,0,8,0" Padding="8,4" Click="BtnAddPair_Click" ToolTip="選択中の左右をペアに追加（どちらか「なし」で片側）">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconPhosphorIcons Kind="Plus" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="ペアに追加" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button MinWidth="100" Margin="0,0,8,0" Padding="8,4" Click="BtnRemovePair_Click" ToolTip="選択中の対応を削除">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconPhosphorIcons Kind="Trash" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="選択を削除" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button MinWidth="120" Margin="0,0,8,0" Padding="8,4" Click="BtnResetSameName_Click" ToolTip="手動対応を破棄し同名自動対応に戻す">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconPhosphorIcons Kind="ArrowCounterClockwise" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="同名にリセット" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <TextBlock
                    x:Name="HintText"
                    VerticalAlignment="Center"
                    Foreground="{StaticResource Brush.TextMuted}"
                    Text="" />
            </StackPanel>

            <!-- 確定ペア一覧 -->
            <DockPanel Grid.Row="2">
                <TextBlock DockPanel.Dock="Top" FontWeight="SemiBold" Text="対応一覧（適用時に使用）" Margin="0,0,0,6" />
                <ListBox x:Name="PairList" DisplayMemberPath="Display" />
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
