<Window
    x:Class="DiffXL.VIEW.Dialogs.ImageOverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    Title="画像重ね合わせ"
    Width="1200"
    Height="800"
    MinWidth="720"
    MinHeight="480"
    WindowStartupLocation="CenterOwner"
    WindowState="Maximized"
    Background="{StaticResource Brush.BgApp}"
    PreviewKeyDown="Window_PreviewKeyDown"
    PreviewKeyUp="Window_PreviewKeyUp"
    Loaded="Window_Loaded"
    UseLayoutRounding="True">
    <DockPanel>
        <!-- 上段: 左 / 切替 / 右 -->
        <Border
            DockPanel.Dock="Top"
            Style="{StaticResource AppToolbarBorderStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ToggleButton
                    x:Name="BtnLeft"
                    Grid.Column="0"
                    Style="{StaticResource ToolBarToggleButtonStyle}"
                    Margin="0,0,6,0"
                    HorizontalAlignment="Stretch"
                    Click="BtnLeft_Click"
                    ToolTip="左画像を前面に表示">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <iconPacks:PackIconPhosphorIcons
                            Kind="ArrowFatLeft"
                            Width="14"
                            Height="14"
                            Margin="0,0,6,0"
                            VerticalAlignment="Center"
                            Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                        <TextBlock
                            x:Name="BtnLeftLabel"
                            VerticalAlignment="Center"
                            Text="左"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </ToggleButton>
                <Button
                    x:Name="BtnToggle"
                    Grid.Column="1"
                    Style="{StaticResource PrimaryButtonStyle}"
                    MinWidth="120"
                    Padding="12,6"
                    MinHeight="30"
                    FontSize="12"
                    Click="BtnToggle_Click"
                    ToolTip="左右の前面を切り替え (F5)">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconPhosphorIcons
                            Kind="ArrowsLeftRight"
                            Width="14"
                            Height="14"
                            Margin="0,0,6,0"
                            VerticalAlignment="Center"
                            Foreground="White" />
                        <TextBlock Text="切替 (F5)" VerticalAlignment="Center" Foreground="White" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>
                <ToggleButton
                    x:Name="BtnRight"
                    Grid.Column="2"
                    Style="{StaticResource ToolBarToggleButtonStyle}"
                    Margin="6,0,0,0"
                    HorizontalAlignment="Stretch"
                    Click="BtnRight_Click"
                    ToolTip="右画像を前面に表示">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <iconPacks:PackIconPhosphorIcons
                            Kind="ArrowFatRight"
                            Width="14"
                            Height="14"
                            Margin="0,0,6,0"
                            VerticalAlignment="Center"
                            Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                        <TextBlock
                            x:Name="BtnRightLabel"
                            VerticalAlignment="Center"
                            Text="右"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </ToggleButton>
            </Grid>
        </Border>

        <!-- 中段: 操作ツールバー -->
        <Border
            DockPanel.Dock="Top"
            Style="{StaticResource AppToolbarBorderStyle}">
            <DockPanel>
                <StackPanel
                    DockPanel.Dock="Left"
                    Orientation="Horizontal"
                    VerticalAlignment="Center">
                    <iconPacks:PackIconPhosphorIcons
                        Kind="Images"
                        Width="16"
                        Height="16"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource Brush.Accent}" />
                    <Button
                        x:Name="BtnCenter"
                        Style="{StaticResource ToolBarButtonStyle}"
                        Margin="0,0,6,0"
                        Click="BtnCenter_Click"
                        ToolTip="画像を中央に表示">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconPhosphorIcons Kind="Crosshair" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="中央" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="Btn100"
                        Style="{StaticResource ToolBarButtonStyle}"
                        Margin="0,0,6,0"
                        Click="Btn100_Click"
                        ToolTip="100% 表示">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconPhosphorIcons Kind="FrameCorners" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="100%" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="BtnFit"
                        Style="{StaticResource ToolBarButtonStyle}"
                        Margin="0,0,6,0"
                        Click="BtnFit_Click"
                        ToolTip="ウィンドウに合わせて表示">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconPhosphorIcons Kind="CornersOut" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Fit" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <ToggleButton
                        x:Name="BtnOverlap"
                        Style="{StaticResource ToolBarToggleButtonStyle}"
                        Margin="0,0,6,0"
                        Click="BtnOverlap_Click"
                        ToolTip="半透明で左右を重ねて表示">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconPhosphorIcons
                                Kind="Stack"
                                Width="14"
                                Height="14"
                                Margin="0,0,6,0"
                                VerticalAlignment="Center"
                                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                            <TextBlock
                                x:Name="BtnOverlapLabel"
                                VerticalAlignment="Center"
                                Text="重ね合わせ" />
                        </StackPanel>
                    </ToggleButton>
                    <Button
                        x:Name="BtnRealign"
                        Style="{StaticResource ToolBarButtonStyle}"
                        Margin="0,0,12,0"
                        Click="BtnRealign_Click"
                        ToolTip="OpenCV で位置合わせをやり直す">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconPhosphorIcons Kind="ArrowsClockwise" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="再合わせ" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button
                        Style="{StaticResource ToolBarButtonStyle}"
                        MinWidth="32"
                        Padding="6,6"
                        Margin="0,0,4,0"
                        Click="BtnZoomMinus_Click"
                        ToolTip="縮小">
                        <iconPacks:PackIconPhosphorIcons Kind="MagnifyingGlassMinus" Width="14" Height="14" VerticalAlignment="Center" />
                    </Button>
                    <Slider
                        x:Name="ZoomSlider"
                        Width="160"
                        Minimum="10"
                        Maximum="1400"
                        Value="100"
                        TickFrequency="5"
                        VerticalAlignment="Center"
                        Margin="0,0,4,0"
                        ValueChanged="ZoomSlider_ValueChanged" />
                    <Button
                        Style="{StaticResource ToolBarButtonStyle}"
                        MinWidth="32"
                        Padding="6,6"
                        Margin="0,0,8,0"
                        Click="BtnZoomPlus_Click"
                        ToolTip="拡大">
                        <iconPacks:PackIconPhosphorIcons Kind="MagnifyingGlassPlus" Width="14" Height="14" VerticalAlignment="Center" />
                    </Button>
                    <TextBlock
                        x:Name="ZoomLabel"
                        Width="52"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource Brush.Text}"
                        FontWeight="SemiBold"
                        Text="100%"
                        TextAlignment="Center" />
                    <TextBlock
                        x:Name="StatusText"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource Brush.TextMuted}"
                        TextTrimming="CharacterEllipsis"
                        Text="" />
                </StackPanel>

                <TextBlock
                    DockPanel.Dock="Right"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Margin="12,0,0,0"
                    Foreground="{StaticResource Brush.TextMuted}"
                    FontSize="11"
                    Text="F5:切替  矢印:微調整(Shift×10)  Ctrl+Wheel:拡大  ドラッグ:移動" />
            </DockPanel>
        </Border>

        <!-- 下段フッタ -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconPhosphorIcons
                        Kind="Info"
                        Width="12"
                        Height="12"
                        Margin="0,0,6,0"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource Brush.TextMuted}" />
                    <TextBlock
                        x:Name="FooterText"
                        VerticalAlignment="Center"
                        Text="画像を位置合わせして表示します" />
                </StackPanel>
            </StatusBarItem>
        </StatusBar>

        <!-- ビューポート（画像確認用の中立グレー背景） -->
        <Border
            Background="{StaticResource Brush.BgMuted}"
            BorderBrush="{StaticResource Brush.Border}"
            BorderThickness="0">
            <Grid>
                <ScrollViewer
                    x:Name="ScrollHost"
                    HorizontalScrollBarVisibility="Visible"
                    VerticalScrollBarVisibility="Visible"
                    Background="{StaticResource Brush.BgMuted}">
                    <Grid x:Name="ImageRoot" Background="{StaticResource Brush.BgMuted}">
                        <Grid.LayoutTransform>
                            <ScaleTransform x:Name="CanvasScale" ScaleX="1" ScaleY="1" />
                        </Grid.LayoutTransform>
                        <Canvas x:Name="LayerRight" Panel.ZIndex="1" IsHitTestVisible="False">
                            <Image
                                x:Name="ImageRight"
                                Stretch="None"
                                SnapsToDevicePixels="True"
                                RenderOptions.BitmapScalingMode="NearestNeighbor" />
                        </Canvas>
                        <Canvas x:Name="LayerLeft" Panel.ZIndex="2" IsHitTestVisible="False">
                            <Image
                                x:Name="ImageLeft"
                                Stretch="None"
                                SnapsToDevicePixels="True"
                                RenderOptions.BitmapScalingMode="NearestNeighbor" />
                        </Canvas>
                    </Grid>
                </ScrollViewer>

                <Border
                    x:Name="PanLayer"
                    Background="#01000000"
                    Margin="0,0,17,17"
                    Cursor="SizeAll"
                    MouseLeftButtonDown="PanLayer_MouseLeftButtonDown"
                    MouseLeftButtonUp="PanLayer_MouseLeftButtonUp"
                    MouseMove="PanLayer_MouseMove"
                    PreviewMouseWheel="PanLayer_PreviewMouseWheel" />

                <Grid
                    x:Name="LoadingOverlay"
                    Background="#80F3F4F6"
                    Visibility="Collapsed">
                    <Border
                        Style="{StaticResource CardBorderStyle}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        MinWidth="280"
                        Padding="28,24">
                        <StackPanel>
                            <iconPacks:PackIconPhosphorIcons
                                Kind="SpinnerGap"
                                Width="28"
                                Height="28"
                                HorizontalAlignment="Center"
                                Foreground="{StaticResource Brush.Accent}" />
                            <TextBlock
                                Margin="0,12,0,0"
                                HorizontalAlignment="Center"
                                FontSize="16"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource Brush.Text}"
                                Text="位置合わせ中…" />
                            <TextBlock
                                x:Name="LoadingDetail"
                                Margin="0,6,0,0"
                                HorizontalAlignment="Center"
                                Foreground="{StaticResource Brush.TextMuted}"
                                FontSize="12"
                                Text="" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </DockPanel>
</Window>
