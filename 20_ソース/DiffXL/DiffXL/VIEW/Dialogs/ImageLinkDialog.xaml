<Window
    x:Class="DiffXL.VIEW.Dialogs.ImageLinkDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    Title="画像対応"
    Width="720"
    Height="520"
    WindowStartupLocation="CenterOwner"
    ResizeMode="CanResizeWithGrip"
    MinWidth="560"
    MinHeight="400">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
            <iconPacks:PackIconPhosphorIcons Kind="Images" Width="16" Height="16" Margin="0,2,8,0" VerticalAlignment="Top" Foreground="{StaticResource Brush.Accent}" />
            <TextBlock
                TextWrapping="Wrap"
                Text="左右の画像を選択して手動で対応付けます。OK でスクロールマップを再構築します（全文再比較はしません）。" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button MinWidth="100" Margin="0,0,8,0" Padding="10,6" Click="BtnClearPins_Click">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconPhosphorIcons Kind="ArrowCounterClockwise" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock Text="自動に戻す" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button MinWidth="88" Margin="0,0,8,0" Padding="10,6" IsCancel="True" Click="BtnCancel_Click">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconPhosphorIcons Kind="X" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock Text="キャンセル" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button
                Style="{StaticResource PrimaryButtonStyle}"
                MinWidth="88"
                Padding="10,6"
                IsDefault="True"
                Click="BtnOk_Click">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconPhosphorIcons Kind="Check" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="White" />
                    <TextBlock Text="OK" VerticalAlignment="Center" Foreground="White" FontWeight="SemiBold" />
                </StackPanel>
            </Button>
        </StackPanel>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <DockPanel Grid.Row="0" Grid.Column="0">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                    <iconPacks:PackIconPhosphorIcons Kind="ArrowFatLeft" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock FontWeight="SemiBold" Text="左の画像" VerticalAlignment="Center" />
                </StackPanel>
                <ListBox
                    x:Name="LeftList"
                    SelectionMode="Single"
                    SelectionChanged="LeftList_SelectionChanged"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="2">
                                <Border Width="64" Height="64" BorderBrush="#CCC" BorderThickness="1" Background="#F7F7F7">
                                    <Image Source="{Binding Thumb}" Stretch="Uniform" Width="64" Height="64" />
                                </Border>
                                <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Caption}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Detail}" Foreground="#666" FontSize="11" />
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
            <DockPanel Grid.Row="0" Grid.Column="2">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                    <iconPacks:PackIconPhosphorIcons Kind="ArrowFatRight" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock FontWeight="SemiBold" Text="右の画像" VerticalAlignment="Center" />
                </StackPanel>
                <ListBox
                    x:Name="RightList"
                    SelectionMode="Single"
                    SelectionChanged="RightList_SelectionChanged"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="2">
                                <Border Width="64" Height="64" BorderBrush="#CCC" BorderThickness="1" Background="#F7F7F7">
                                    <Image Source="{Binding Thumb}" Stretch="Uniform" Width="64" Height="64" />
                                </Border>
                                <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Caption}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Detail}" Foreground="#666" FontSize="11" />
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
            <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,10,0,6">
                <Button x:Name="BtnPair" MinWidth="120" Padding="10,6" Margin="0,0,8,0" Click="BtnPair_Click">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconPhosphorIcons Kind="Link" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="ペアにする" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button x:Name="BtnUnpair" MinWidth="120" Padding="10,6" Click="BtnUnpair_Click">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconPhosphorIcons Kind="X" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="選択のピン解除" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <DockPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
                    <iconPacks:PackIconPhosphorIcons Kind="PushPin" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock FontWeight="SemiBold" Text="手動ピン" VerticalAlignment="Center" />
                </StackPanel>
                <ListBox x:Name="PinList" Height="100" DisplayMemberPath="Display" />
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
