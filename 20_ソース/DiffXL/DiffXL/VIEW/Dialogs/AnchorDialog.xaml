<Window
    x:Class="DiffXL.VIEW.Dialogs.AnchorDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    Title="アンカー設定"
    Width="420"
    Height="260"
    WindowStartupLocation="CenterOwner"
    ResizeMode="NoResize">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
            <iconPacks:PackIconPhosphorIcons Kind="Anchor" Width="16" Height="16" Margin="0,2,8,0" VerticalAlignment="Top" Foreground="{StaticResource Brush.Accent}" />
            <TextBlock
                TextWrapping="Wrap"
                Text="比較を開始するセル位置（例: A10）を指定します。指定行より上は比較対象外になります。" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button MinWidth="88" Margin="0,0,8,0" Padding="10,6" IsCancel="True" Click="BtnCancel_Click">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconPhosphorIcons Kind="X" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock Text="キャンセル" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button
                Style="{StaticResource PrimaryButtonStyle}"
                MinWidth="88"
                Padding="10,6"
                IsDefault="True"
                Click="BtnOk_Click">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconPhosphorIcons Kind="Check" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="White" />
                    <TextBlock Text="適用して再比較" VerticalAlignment="Center" Foreground="White" FontWeight="SemiBold" />
                </StackPanel>
            </Button>
        </StackPanel>
        <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <iconPacks:PackIconPhosphorIcons Kind="ArrowFatLeft" Width="12" Height="12" Margin="0,0,6,0" VerticalAlignment="Center" />
                <TextBlock Text="左アンカー" VerticalAlignment="Center" />
            </StackPanel>
            <TextBox x:Name="LeftAnchorBox" Margin="0,0,0,12" Padding="6,4" Text="A1" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <iconPacks:PackIconPhosphorIcons Kind="ArrowFatRight" Width="12" Height="12" Margin="0,0,6,0" VerticalAlignment="Center" />
                <TextBlock Text="右アンカー" VerticalAlignment="Center" />
            </StackPanel>
            <TextBox x:Name="RightAnchorBox" Margin="0,0,0,0" Padding="6,4" Text="A1" />
        </StackPanel>
    </DockPanel>
</Window>
