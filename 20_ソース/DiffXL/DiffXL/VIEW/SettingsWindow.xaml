<Window
    x:Class="DiffXL.VIEW.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    Title="設定"
    Width="480"
    Height="500"
    MinWidth="420"
    MinHeight="400"
    WindowStartupLocation="CenterOwner"
    ResizeMode="CanResizeWithGrip"
    Background="#F9FAFB">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button
                x:Name="BtnCancel"
                MinWidth="88"
                Margin="0,0,8,0"
                Padding="12,6"
                IsCancel="True"
                Click="BtnCancel_Click">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconPhosphorIcons Kind="X" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock Text="キャンセル" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button
                x:Name="BtnSave"
                Style="{StaticResource PrimaryButtonStyle}"
                MinWidth="88"
                Padding="12,6"
                IsDefault="True"
                Click="BtnSave_Click">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconPhosphorIcons Kind="FloppyDisk" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="White" />
                    <TextBlock Text="保存" VerticalAlignment="Center" Foreground="White" FontWeight="SemiBold" />
                </StackPanel>
            </Button>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <iconPacks:PackIconPhosphorIcons Kind="Palette" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{StaticResource Brush.Accent}" />
                    <TextBlock
                        FontSize="16"
                        FontWeight="SemiBold"
                        VerticalAlignment="Center"
                        Text="差分強調" />
                </StackPanel>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="差分色 (#RRGGBB)" />
                    <TextBox
                        x:Name="ColorTextBox"
                        Grid.Column="1"
                        Padding="6,4"
                        Text="#FFFF00"
                        TextChanged="ColorOrOpacity_Changed" />
                </Grid>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="48" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="不透明度" />
                    <Slider
                        x:Name="OpacitySlider"
                        Grid.Column="1"
                        Minimum="0"
                        Maximum="100"
                        Value="50"
                        TickFrequency="5"
                        IsSnapToTickEnabled="False"
                        VerticalAlignment="Center"
                        ValueChanged="ColorOrOpacity_Changed" />
                    <TextBlock
                        x:Name="OpacityLabel"
                        Grid.Column="2"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        Text="50%" />
                </Grid>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="プレビュー" />
                    <Border
                        Grid.Column="1"
                        Height="40"
                        BorderBrush="#D1D5DB"
                        BorderThickness="1"
                        CornerRadius="4">
                        <Rectangle x:Name="PreviewRect" />
                    </Border>
                </Grid>

                <CheckBox
                    x:Name="HighlightEnabledCheck"
                    Margin="0,0,0,16"
                    Content="起動時に差分強調を表示する"
                    IsChecked="True" />

                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <iconPacks:PackIconPhosphorIcons Kind="ArrowsDownUp" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{StaticResource Brush.Accent}" />
                    <TextBlock
                        FontSize="16"
                        FontWeight="SemiBold"
                        VerticalAlignment="Center"
                        Text="同期" />
                </StackPanel>

                <CheckBox
                    x:Name="SyncScrollCheck"
                    Margin="0,0,0,8"
                    Content="左右ビューを同期スクロールする"
                    IsChecked="True"
                    ToolTip="Ui.SyncScroll — OFF で左右独立・ギャップ表示も停止" />

                <CheckBox
                    x:Name="ShowSyncGapOverlayCheck"
                    Margin="0,0,0,8"
                    Content="ギャップ表示（内容ギャップ時の説明オーバーレイ）"
                    IsChecked="True"
                    ToolTip="Ui.ShowSyncGapOverlay" />

                <CheckBox
                    x:Name="ShowSyncToastOnJumpCheck"
                    Margin="0,0,0,8"
                    Content="再同期メッセージ（ジャンプ時の短い通知）"
                    IsChecked="True"
                    ToolTip="Ui.ShowSyncToastOnJump" />

                <CheckBox
                    x:Name="ReduceMotionCheck"
                    Margin="0,0,0,8"
                    Content="動きを減らす（再同期の中間スクロールを行わない）"
                    IsChecked="False"
                    ToolTip="Ui.ReduceMotion" />

                <Grid Margin="0,4,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="72" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Text="保険ポーリング (ms)"
                        ToolTip="Ui.SyncPollFallbackMs — イベント駆動の保険間隔（100–1000）" />
                    <TextBox
                        x:Name="SyncPollFallbackMsBox"
                        Grid.Column="1"
                        Padding="6,4"
                        Text="250"
                        ToolTip="100〜1000（既定 250）" />
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                    <iconPacks:PackIconPhosphorIcons Kind="Info" Width="14" Height="14" Margin="0,2,6,0" VerticalAlignment="Top" Foreground="#6B7280" />
                    <TextBlock
                        Foreground="#6B7280"
                        TextWrapping="Wrap"
                        Text="設定は %AppData%\Roaming\DiffXL\settings.yaml に保存されます。既定の差分色は黄色・不透明度 50%、保険ポーリング 250ms です。" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
